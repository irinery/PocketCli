    echo ""
    printf "  ${C_BOLD}PocketCli${C_NC}  ${C_DIM}— portable terminal toolkit${C_NC}\n"
    echo ""
    printf "  ${C_BOLD}Usage:${C_NC}  pocket [-e|--explain] <command> [args]\n"
    echo ""
    printf "  ${C_CYAN}connect${C_NC}  [host]           SSH into a machine\n"
    printf "  ${C_CYAN}list${C_NC}                     List Tailscale machines\n"
    printf "  ${C_CYAN}run${C_NC}      <host> <cmd>    Run command remotely\n"
    printf "  ${C_CYAN}copy${C_NC}     <src>  <dst>    scp wrapper (host:path)\n"
    printf "  ${C_CYAN}fleet${C_NC}    <sub>  [args]   Commands across machines\n"
    printf "  ${C_CYAN}investigate${C_NC} [args]       Investigate authorized history (Agent)\n"
    printf "  ${C_CYAN}ansible${C_NC}  <sub>  [args]   Run Ansible playbooks through PocketCli\n"
    printf "  ${C_CYAN}status${C_NC}                   Local node status\n"
    printf "  ${C_CYAN}radar${C_NC}                    Radar dashboard\n"
    printf "  ${C_CYAN}menu${C_NC}                     Interactive menu\n"
    printf "  ${C_CYAN}resume${C_NC}                   Restore/attach the PocketCli tmux session\n"
    echo ""
    printf "  ${C_CYAN}tailscale-setup${C_NC}          Install + start + auth (shows QR)\n"
    printf "  ${C_CYAN}tailscale-start${C_NC}          Start the Tailscale backend\n"
    printf "  ${C_CYAN}tailscale-restart${C_NC}        Restart the Tailscale backend\n"
    printf "  ${C_CYAN}tailscale-status${C_NC}         Show Tailscale peers and IP\n"
    printf "  ${C_CYAN}tailscale-auth${C_NC}           Re-authenticate (shows QR)\n"
    printf "  ${C_CYAN}tailscale-ping${C_NC}  <host>   Check host reachability via ping\n"
    printf "  ${C_CYAN}ts-ping${C_NC}         <host>   Alias for tailscale-ping\n"
    echo ""
    printf "  ${C_CYAN}doctor${C_NC}                   Run compatibility tests\n"
    printf "  ${C_CYAN}update${C_NC}                   Update PocketCli\n"
    printf "  ${C_CYAN}uninstall${C_NC}                Remove PocketCli\n"
    printf "  ${C_CYAN}help${C_NC}                     This help\n"
    printf "  ${C_CYAN}-e, --explain${C_NC}            Show explicit logs for each execution step\n"
    echo ""
    if is_ish; then
        printf "  ${C_DIM}[iSH detected — using compatible mode]${C_NC}\n\n"
    fi
}

_cmd_list() {
    TS_STATUS=""
    if has_tailscale_cli && command -v jq >/dev/null 2>&1; then
        TS_STATUS=$(tailscale_status_json 2>/dev/null || true)
    fi

    if [ -z "${TS_STATUS}" ]; then
        TARGETS=$(list_fallback_targets)
        if [ -z "${TARGETS}" ]; then
            if is_tailscale_mesh_operational; then
                die "Tailscale mesh is operational, but peer listing requires CLI integration or saved hosts."
            fi
            die "Tailscale mesh unavailable and no saved hosts found. Run: pocket tailscale-setup"
        fi

        echo ""
        warn "Tailscale peer API unavailable — listing saved/seed hosts."
        printf "  ${C_BOLD}%-22s %-16s %-10s${C_NC}\n" "Hostname" "IP" "Status"
        printf "  %-22s %-16s %-10s\n" "----------------------" "----------------" "----------"
        printf '%s\n' "${TARGETS}" | while IFS= read -r host; do
            [ -n "${host}" ] || continue
            ip=$(resolve_tailscale_ip_for_host "${host}" 2>/dev/null || true)
            if is_ip_target "${host}"; then
                ip="${host}"
            fi
            [ -n "${ip}" ] || ip="n/a"
            status="saved"
            ping_host "${host}" 2 && status="reachable"
            printf "  %-22s %-16s %-10s\n" "${host}" "${ip}" "${status}"
        done
        echo ""
        return 0
    fi

    echo ""
    printf "  ${C_BOLD}%-22s %-16s %-8s %-12s${C_NC}\n" "Hostname" "IP" "Online" "OS"
    printf "  %-22s %-16s %-8s %-12s\n" \
        "----------------------" "----------------" "--------" "------------"

    printf '%s' "${TS_STATUS}" | jq -r '
        .Peer | to_entries[] | .value |
        "\(.HostName) \(.TailscaleIPs[0] // "n/a") \(if .Online then "yes" else "no" end) \(.OS // "?")"
    ' | while IFS=' ' read -r host ip online os; do
        host=$(safe_host "${host}")
        ip=$(printf '%s' "${ip}" | tr -cd '0-9.:')
        printf "  %-22s %-16s %-8s %-12s\n" "${host}" "${ip}" "${online}" "${os}"
    done
    echo ""
}

_cmd_connect() {
    [ -x "${SCRIPTS}/ssh/open.sh" ] || die "Secure SSH wrapper unavailable: ${SCRIPTS}/ssh/open.sh"
    HOST="${1:-}"

    if [ -z "${HOST}" ]; then
        PEERS=$(list_known_hosts || true)
        [ -z "${PEERS}" ] && die "No Tailscale or saved machines found."

        echo ""
        echo "  Online machines:"
        echo ""
        I=1
        printf '%s\n' "${PEERS}" | while IFS= read -r h; do
            printf "    %d)  %s\n" "${I}" "${h}"
            I=$((I + 1))
        done
        echo ""
        printf "  Number or hostname: "
        read -r INPUT < /dev/tty

        case "${INPUT}" in
            ''|*[!0-9]*)
                HOST=$(safe_host "${INPUT}")
            ;;
            *)
                HOST=$(printf '%s\n' "${PEERS}" | sed -n "${INPUT}p" | tr -cd 'a-zA-Z0-9._-')
            ;;
        esac
    fi

    exec sh "${SCRIPTS}/ssh/open.sh" --run interactive "${HOST}"
}

_cmd_run() {
    [ $# -lt 2 ] && die "Usage: pocket run <host> <command>"
    [ -x "${SCRIPTS}/ssh/exec.sh" ] || die "Secure SSH wrapper unavailable: ${SCRIPTS}/ssh/exec.sh"
    HOST="$1"; shift
    exec sh "${SCRIPTS}/ssh/exec.sh" "${HOST}" "$@"
}

_cmd_copy() {
    [ $# -lt 2 ] && die "Usage: pocket copy <src> <dst>"
    [ -x "${SCRIPTS}/ssh/copy.sh" ] || die "Secure SSH wrapper unavailable: ${SCRIPTS}/ssh/copy.sh"
    exec sh "${SCRIPTS}/ssh/copy.sh" "$1" "$2"
}

_cmd_status() { exec sh "${SCRIPTS}/pocket-status.sh"; }
_cmd_radar()  { exec sh "${POCKETCLI_DIR}/radar.sh"; }
_cmd_menu() {
    if [ "${POCKETCLI_DIRECT_MENU:-0}" != "1" ] && [ -x "${SCRIPTS}/session/manager.sh" ]; then
        SESSION_INTENT="viewer" exec sh "${SCRIPTS}/session/manager.sh" viewer
    fi
    exec sh "${SCRIPTS}/pocketcli_menu.sh"
}
_cmd_doctor() { exec sh "${POCKETCLI_DIR}/tests/test_ish.sh"; }

# The Investigation Agent is a separate Go binary with the SQLite engine.
# Nothing installs it, so on first use offer to build it from this checkout.
# POCKETCLI_INVESTIGATE_BUILD=yes builds without asking, =no never builds.
# An explicit POCKETCLI_GO_BINARY is never replaced by a build.
_investigate_ensure_binary() {
    _inv_bin="${POCKETCLI_GO_BINARY:-${POCKETCLI_DIR}/bin/pocket-go}"
    [ -x "${_inv_bin}" ] && return 0
    if _investigate_build_running; then
        die "O Investigation Agent ainda está sendo compilado em segundo plano. Aguarde terminar (log: ${_inv_bin}.build.log) e rode de novo."
    fi
    _inv_cmd="CGO_ENABLED=1 go build -buildvcs=false -tags investigate_sqlite -o ${_inv_bin} ./cmd/pocket"
    _inv_mode="${POCKETCLI_INVESTIGATE_BUILD:-ask}"
    if [ -n "${POCKETCLI_GO_BINARY:-}" ] || [ "${_inv_mode}" = "no" ]; then
        die "Investigation Agent unavailable. Build with ${_inv_cmd}"
    fi
    command -v go >/dev/null 2>&1 \
        || die "Investigation Agent unavailable and Go 1.22+ was not found. Install Go, then build with ${_inv_cmd}"
    [ -d "${POCKETCLI_DIR}/cmd/pocket" ] \
        || die "Investigation Agent unavailable and ${POCKETCLI_DIR}/cmd/pocket is missing. Build from a PocketCli checkout with ${_inv_cmd}"
    command -v cc >/dev/null 2>&1 || command -v clang >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 \
        || die "Investigation Agent needs a C compiler (CGO) to build. Install one, then run ${_inv_cmd}"
    if [ "${_inv_mode}" != "yes" ]; then
        _inv_interactive=1
        [ -t 0 ] && [ -t 2 ] || _inv_interactive=0
        for _inv_arg in "$@"; do
            [ "${_inv_arg}" = "--json" ] && _inv_interactive=0
        done
        [ "${_inv_interactive}" = "1" ] \
            || die "Investigation Agent not built. Run ${_inv_cmd} (or set POCKETCLI_INVESTIGATE_BUILD=yes to build on demand)"
        printf "%s" "Investigation Agent ainda não foi compilado. Compilar agora com Go + CGO (cerca de 1 minuto)? [S/n] " >&2
        read -r _inv_answer || _inv_answer=n
        case "${_inv_answer}" in
            ''|s|S|sim|Sim|y|Y|yes|Yes) ;;
            *) die "Investigation Agent not built. Run ${_inv_cmd}" ;;
        esac
    fi
    if ! _investigate_build_binary; then
        die "Build failed. Run it by hand to see the error: ${_inv_cmd}"
    fi
    printf '%s\n' "[PocketCli] Investigation Agent instalado em ${_inv_bin}. O pocket update recompila quando houver versão nova." >&2
}

# Builds the agent into ${_inv_bin} through a temporary file, so a failed
# build never replaces a working binary, and records the commit the sources
# were at when the build started in ${_inv_bin}.rev (pocket update compares
# it with HEAD).
_investigate_build_binary() {
    mkdir -p "$(dirname "${_inv_bin}")"
    _inv_tmp="${_inv_bin}.build.$$"
    _inv_rev=$(git -C "${POCKETCLI_DIR}" rev-parse HEAD 2>/dev/null || true)
    printf '%s\n' "[PocketCli] Compilando o Investigation Agent..." >&2
    if ! (cd "${POCKETCLI_DIR}" && CGO_ENABLED=1 go build -buildvcs=false -tags investigate_sqlite -o "${_inv_tmp}" ./cmd/pocket) >&2; then
        rm -f "${_inv_tmp}"
        return 1
    fi
    mv "${_inv_tmp}" "${_inv_bin}"
    if [ -n "${_inv_rev}" ]; then
        printf '%s\n' "${_inv_rev}" >"${_inv_bin}.rev"
    else
        rm -f "${_inv_bin}.rev"
    fi
}

# The agent is compiled in the background after an update. Until the new
# binary is complete and swapped in with one rename, the previous one keeps
# serving. A lock directory (with the builder's pid) says a build is running,
# ${_inv_bin}.build.log keeps its output and ${_inv_bin}.failed marks a build
# that did not finish.
_investigate_build_running() {
    _inv_lock="${_inv_bin}.lock"
    [ -d "${_inv_lock}" ] || return 1
    _inv_pid=$(cat "${_inv_lock}/pid" 2>/dev/null || true)
    if [ -n "${_inv_pid}" ] && kill -0 "${_inv_pid}" 2>/dev/null; then
        return 0
    fi
    rm -rf "${_inv_lock}" # the builder died without releasing it
    return 1
}

# Hidden command: `pocket __build-agent` is the background builder.
_cmd_build_agent() {
    _inv_bin="${POCKETCLI_GO_BINARY:-${POCKETCLI_DIR}/bin/pocket-go}"
    mkdir -p "$(dirname "${_inv_bin}")"
    if [ "${POCKETCLI_BUILD_LOCK_HELD:-}" = "1" ]; then
        _inv_lock="${_inv_bin}.lock" # taken by pocket update before it started this builder
    else
        if _investigate_build_running; then
            return 0
        fi
        mkdir "${_inv_lock}" 2>/dev/null || return 0
    fi
    printf '%s\n' "$$" >"${_inv_lock}/pid"
    rm -f "${_inv_bin}.failed"
    if _investigate_build_binary; then
        printf '%s\n' "[PocketCli] Investigation Agent compilado e liberado." >&2
    else
        printf '%s\n' "build falhou em $(date -u +%Y-%m-%dT%H:%M:%SZ); o binário anterior foi mantido" >"${_inv_bin}.failed"
        printf '%s\n' "[PocketCli] Build do Investigation Agent falhou; o binário anterior foi mantido." >&2
    fi
    rm -rf "${_inv_lock}"
    return 0
}

# After an update, bring the agent to the current commit: compile in the
# background (or, with POCKETCLI_INVESTIGATE_BUILD_WAIT=yes, wait for it) when
# the binary is missing or its recorded commit differs from HEAD. Never
# replaces an explicit POCKETCLI_GO_BINARY, honors
# POCKETCLI_INVESTIGATE_BUILD=no, and never fails the update: without Go, a
# C compiler or the sources it only says what to run.
_update_investigate_agent() {
    _inv_bin="${POCKETCLI_DIR}/bin/pocket-go"
    if [ -n "${POCKETCLI_GO_BINARY:-}" ] || [ "${POCKETCLI_INVESTIGATE_BUILD:-}" = "no" ]; then
        return 0
    fi
    explain_step "Checking the Investigation Agent build"
    _inv_head=$(git -C "${POCKETCLI_DIR}" rev-parse HEAD 2>/dev/null || true)
    _inv_built=$(cat "${_inv_bin}.rev" 2>/dev/null || true)
    if [ -x "${_inv_bin}" ] && [ -n "${_inv_head}" ] && [ "${_inv_head}" = "${_inv_built}" ]; then
        explain "Investigation Agent already built from ${_inv_head}."
        return 0
    fi
    _inv_cmd="cd ${POCKETCLI_DIR} && CGO_ENABLED=1 go build -buildvcs=false -tags investigate_sqlite -o ${_inv_bin} ./cmd/pocket"
    if [ ! -d "${POCKETCLI_DIR}/cmd/pocket" ]; then
        explain "No Go sources in ${POCKETCLI_DIR}; nothing to build."
        return 0
    fi
    if ! command -v go >/dev/null 2>&1 \
        || ! { command -v cc >/dev/null 2>&1 || command -v clang >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1; }; then
        if [ -x "${_inv_bin}" ]; then
            warn "Investigation Agent desatualizado e sem Go/compilador C para recompilar. Rode: ${_inv_cmd}"
        else
            explain "Go and a C compiler are needed to build the Investigation Agent: ${_inv_cmd}"
        fi
        return 0
    fi
    if _investigate_build_running; then
        info "O Investigation Agent já está sendo compilado em segundo plano."
        return 0
    fi
    _inv_log="${_inv_bin}.build.log"
    mkdir -p "$(dirname "${_inv_bin}")"
    if [ "${POCKETCLI_INVESTIGATE_BUILD_WAIT:-}" = "yes" ]; then
        info "Compilando o Investigation Agent (aguardando)..."
        _cmd_build_agent >"${_inv_log}" 2>&1 || true
        if [ -e "${_inv_bin}.failed" ]; then
            warn "Falha ao compilar o Investigation Agent; o binário anterior foi mantido. Log: ${_inv_log}"
        else
            ok "Investigation Agent compilado."
        fi
        return 0
    fi
    # Take the lock here, so nothing can start a second build or offer one
    # while the background process is still starting.
    mkdir "${_inv_bin}.lock" 2>/dev/null || return 0
    printf '%s\n' "$$" >"${_inv_bin}.lock/pid"
    POCKETCLI_BUILD_LOCK_HELD=1 nohup sh "${POCKETCLI_DIR}/pocket" __build-agent >"${_inv_log}" 2>&1 </dev/null &
    printf '%s\n' "$!" >"${_inv_bin}.lock/pid"
    info "Compilando o Investigation Agent em segundo plano (cerca de 1 minuto)."
    explain_kv "build_log" "${_inv_log}"
    if [ -x "${_inv_bin}" ]; then
        info "A versão atual continua em uso e só é trocada quando a nova ficar pronta. Log: ${_inv_log}"
    else
        info "O pocket investigate fica disponível quando terminar. Log: ${_inv_log}"
    fi
    return 0
}

# What a running or failed background build means for the command about to run.
_investigate_report_build_state() {
    if _investigate_build_running; then
        printf '%s\n' "[PocketCli] O Investigation Agent está sendo atualizado em segundo plano; usando a versão atual até terminar (log: ${_inv_bin}.build.log)." >&2
    elif [ -e "${_inv_bin}.failed" ]; then
        printf '%s\n' "[PocketCli] A última compilação do Investigation Agent falhou ($(cat "${_inv_bin}.failed")). Log: ${_inv_bin}.build.log. Rode pocket update para tentar de novo." >&2
    fi
}

_cmd_investigate() {
    _investigate_ensure_binary "$@"
    _investigate_report_build_state
    exec "${_inv_bin}" investigate "$@"
}

_persist_command_if_needed() {
    case "${1:-}" in
        ''|help|-h|--help|version|-v|--version|resume|__restore|__build-agent|session) return 0 ;;
    esac
    for _persist_arg in "$@"; do
        case "${_persist_arg}" in
            --approval-token|--approval-token=*) return 0 ;;
        esac
    done
    pocket_save_command "$@"
}

_cmd_resume() {
    if [ -x "${SCRIPTS}/session/manager.sh" ]; then
        SESSION_INTENT="resume" exec sh "${SCRIPTS}/session/manager.sh" auto
    fi

    require tmux
    SESSION=$(pocket_tmux_session)

    if tmux has-session -t "${SESSION}" 2>/dev/null; then
        info "Reattaching tmux session ${SESSION}..."
    else
        info "Creating tmux session ${SESSION} from the last PocketCli command..."
        if [ ! -s "$(pocket_last_command_file)" ]; then
            pocket_save_command menu
        fi
        tmux new-session -d -s "${SESSION}"
        POCKET_CMD=$(printf "'%s'" "$(printf '%s' "${POCKETCLI_DIR}/pocket" | sed "s/'/'\\\\''/g")")
        tmux send-keys -t "${SESSION}" "POCKETCLI_RESTORE=1 ${POCKET_CMD} __restore" C-m
        tmux source-file "${HOME}/.config/tmux/tmux.conf" 2>/dev/null || true
    fi

    exec tmux attach-session -t "${SESSION}"
}

_cmd_restore() {
    if [ -x "${SCRIPTS}/session/manager.sh" ]; then
        SESSION_INTENT="resume" exec sh "${SCRIPTS}/session/manager.sh" auto
    fi

    set --
    FILE=$(pocket_last_command_file)
    if [ -f "${FILE}" ] && [ -s "${FILE}" ]; then
        while IFS= read -r _arg || [ -n "${_arg}" ]; do
            set -- "$@" "${_arg}"
        done < "${FILE}"
    fi

    [ $# -gt 0 ] || set -- menu
    exec sh "${POCKETCLI_DIR}/pocket" "$@"
}

_cmd_fleet() {
    exec sh "${SCRIPTS}/fleet.sh" "$@"
}

_cmd_ansible() {
    exec sh "${POCKETCLI_DIR}/lib/ansible_adapter.sh" "$@"
}

_cmd_ts() {
    # All tailscale-* commands delegate to tailscale_daemon.sh
    exec sh "${SCRIPTS}/tailscale_daemon.sh" "$@"
}

_restore_update_stash() {
    REPO_DIR="$1"
    STASH_REF="$2"

    [ -n "${STASH_REF}" ] || return 0

    if git -C "${REPO_DIR}" stash pop --quiet >/dev/null 2>&1; then
        ok "Local changes restored after update."
    else
        warn "Update completed, but local changes need manual review (git -C ${REPO_DIR} stash list)."
    fi
}

_clear_install_tree_preserving_profile() {
    REPO_DIR="$1"

    [ -d "${REPO_DIR}" ] || return 0

    for ENTRY in "${REPO_DIR}"/.[!.]* "${REPO_DIR}"/..?* "${REPO_DIR}"/*; do
        [ -e "${ENTRY}" ] || continue
        if [ "$(basename "${ENTRY}")" = "profile" ]; then
            continue
        fi
        rm -rf "${ENTRY}"
    done
}

_seed_repo_from_remote() {
    REPO_DIR="$1"
    TMP_ROOT=$(mktemp -d)
    TMP_REPO="${TMP_ROOT}/repo"
    PROFILE_BACKUP="${TMP_ROOT}/profile"
    HAD_PROFILE=0

    if [ -d "${REPO_DIR}/profile" ]; then
        HAD_PROFILE=1
        cp -R "${REPO_DIR}/profile" "${PROFILE_BACKUP}"
    fi

    if ! git clone --quiet --branch "${POCKETCLI_REPO_REF}" "${POCKETCLI_REPO_URL}" "${TMP_REPO}" >/dev/null 2>&1; then
        rm -rf "${TMP_ROOT}"
        return 1
    fi

    mkdir -p "${REPO_DIR}"
    _clear_install_tree_preserving_profile "${REPO_DIR}"
    (
        cd "${TMP_REPO}" &&
        tar -cf - --exclude=.git .
    ) | (
        cd "${REPO_DIR}" &&
        tar -xf -
    )

    rm -rf "${REPO_DIR}/.git"
    cp -R "${TMP_REPO}/.git" "${REPO_DIR}/.git"

    if [ "${HAD_PROFILE}" -eq 1 ]; then
        mkdir -p "${REPO_DIR}/profile"
        cp -R "${PROFILE_BACKUP}/." "${REPO_DIR}/profile/"
    fi

    rm -rf "${TMP_ROOT}"
    return 0
}

_cmd_update() {
    step "Updating PocketCli"
    REPO_DIR="${POCKETCLI_DIR}"
    STASH_REF=""

    explain_step "Preparing repository context"
    explain_kv "repo_dir" "${REPO_DIR}"
    explain_kv "repo_ref" "${POCKETCLI_REPO_REF}"

    if ! git -C "${REPO_DIR}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        warn "Current install is missing git metadata; rebuilding update context..."
        explain "The installation was not detected as a git repository; seeding tracked files from remote."
        if _seed_repo_from_remote "${REPO_DIR}"; then
            ok "Update context rebuilt from ${POCKETCLI_REPO_REF}."
        else
            warn "Could not rebuild update context automatically."
            explain "Failed to clone/update repository metadata from remote."
            return 0
        fi
    fi

    explain_step "Checking stash state before update"
    BEFORE_STASH=$(git -C "${REPO_DIR}" rev-parse -q --verify refs/stash 2>/dev/null || true)
    explain_kv "stash_before" "${BEFORE_STASH:-none}"

    explain_step "Checking local modifications"
    WORKTREE_STATUS=$(git -C "${REPO_DIR}" status --porcelain 2>/dev/null || true)
    if [ -n "${WORKTREE_STATUS}" ]; then
        explain "Local modifications detected; creating a temporary stash before updating."
        explain_block "worktree_status" "${WORKTREE_STATUS}"
        info "Saving local changes before update..."
        git -C "${REPO_DIR}" stash push --include-untracked --quiet -m "pocketcli-update" >/dev/null 2>&1 || true
        AFTER_STASH=$(git -C "${REPO_DIR}" rev-parse -q --verify refs/stash 2>/dev/null || true)
        explain_kv "stash_after_push" "${AFTER_STASH:-none}"
        if [ -n "${AFTER_STASH}" ] && [ "${AFTER_STASH}" != "${BEFORE_STASH}" ]; then
            STASH_REF="${AFTER_STASH}"
            explain_kv "active_temp_stash" "${STASH_REF}"
        else
            explain "No new stash entry was created; continuing without a temporary stash reference."
        fi
    else
        explain "Working tree is clean; update will run without creating a stash."
    fi

    explain_step "Fetching remote changes"
    if git -C "${REPO_DIR}" fetch --quiet origin; then
        explain "Fetch completed successfully."
    else
        warn "Update failed — check git status."
        explain "Fetch failed; restoring any temporary stash before exiting."
        _restore_update_stash "${REPO_DIR}" "${STASH_REF}"
        return 0
    fi

    explain_step "Applying fast-forward update"
    if git -C "${REPO_DIR}" pull --ff-only; then
        ok "PocketCli updated."
        explain "Fast-forward pull completed successfully."
    else
        warn "Update failed — check git status."
        explain "Pull failed; restoring any temporary stash before exiting."
        _restore_update_stash "${REPO_DIR}" "${STASH_REF}"
        return 0
    fi

    explain_step "Restoring local modifications"
    _restore_update_stash "${REPO_DIR}" "${STASH_REF}"
    _update_investigate_agent
}

_cmd_uninstall() { exec sh "${SCRIPTS}/uninstall.sh"; }

_cmd_version() {
    VER=$(git -C "${POCKETCLI_DIR}" describe --tags --always 2>/dev/null || printf 'dev')
    printf 'PocketCli %s\n' "${VER}"
}

# =============================================================================
# Dispatch
# =============================================================================

_has_interactive_tty() {
    [ -r /dev/tty ] || [ -c /dev/tty ]
}

POCKETCLI_EXPLAIN="${POCKETCLI_EXPLAIN:-0}"
while [ $# -gt 0 ]; do
    case "$1" in
        -e|--explain)
            POCKETCLI_EXPLAIN=1
            shift
            ;;
        *)
            break
            ;;
    esac
done
export POCKETCLI_EXPLAIN

CMD="${1:-}"
if [ -z "${CMD}" ]; then
    if _has_interactive_tty; then
        if [ -x "${SCRIPTS}/session/manager.sh" ]; then
            CMD="session"
        elif [ -z "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
            CMD="resume"
        else
            CMD="menu"
        fi
    else
        CMD="help"
    fi
else
    shift
fi

if explain_enabled; then
    explain_step "PocketCli invocation"
    explain_kv "command" "${CMD}"
    explain_kv "args" "$*"
    explain_kv "home" "${HOME}"
    explain_kv "pocketcli_dir" "${POCKETCLI_DIR}"
fi

_persist_command_if_needed "${CMD}" "$@"

case "${CMD}" in
    session)
        if [ -x "${SCRIPTS}/session/manager.sh" ]; then
            SESSION_INTENT="boot" exec sh "${SCRIPTS}/session/manager.sh" auto
        fi
        _cmd_menu
    ;;
    connect)                    _cmd_connect "$@" ;;
    list|ls)                    _cmd_list ;;
    run)                        _cmd_run "$@" ;;
    copy|cp)                    _cmd_copy "$@" ;;
    fleet)                      _cmd_fleet "$@" ;;
    investigate)                _cmd_investigate "$@" ;;
    ansible)                    _cmd_ansible "$@" ;;
    scan)                       exec sh "${POCKETCLI_DIR}/discovery/pocketcli-scan.sh" ;;
    status)                     _cmd_status ;;
    radar)                      _cmd_radar ;;
    menu)                       _cmd_menu ;;
    doctor)                     _cmd_doctor ;;
    resume)                     _cmd_resume ;;
    __restore)                  _cmd_restore ;;
    __build-agent)              _cmd_build_agent ;;
    tailscale-setup)            _cmd_ts setup ;;
    tailscale-start)            _cmd_ts start ;;
    tailscale-restart)          _cmd_ts restart ;;
    tailscale-stop)             _cmd_ts stop ;;
    tailscale-status)           _cmd_ts status ;;
    tailscale-auth)             _cmd_ts auth ;;
    tailscale-ping)             _cmd_ts ping "$@" ;;
    ts-ping)                    _cmd_ts ping "$@" ;;
    update)                     _cmd_update ;;
    uninstall)                  _cmd_uninstall ;;
    version|-v|--version)       _cmd_version ;;
    help|-h|--help|"")          _cmd_help ;;
    *)
        warn "Unknown command: '${CMD}'"
        _cmd_help; exit 1
    ;;
esac
