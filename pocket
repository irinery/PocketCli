#!/usr/bin/env sh
# =============================================================================
# PocketCli — pocket
# Main CLI. Pure POSIX sh. Works on iSH / Alpine / Linux / macOS.
# =============================================================================

set -eu

POCKETCLI_DIR="${HOME}/.pocketcli"
SCRIPTS="${POCKETCLI_DIR}/scripts"
POCKETCLI_REPO_URL="${POCKETCLI_REPO_URL:-https://github.com/irinery/PocketCli.git}"
POCKETCLI_REPO_REF="${POCKETCLI_REPO_REF:-main}"

# Load shared helpers
. "${SCRIPTS}/lib/common.sh"

# =============================================================================
# Commands
# =============================================================================

