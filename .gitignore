.DS_Store

# Local project folders
skills/

# Local generated technical contracts requested as Docs/; on this macOS checkout
# Docs/ resolves to the existing docs/ directory, so keep the ignore scoped.
/docs/command-catalogue-contracts/
# Ansible local state and secrets
ansible/inventory.ini
ansible/*.retry
ansible/.vault-password*
ansible/**/.vault-password*

# Environment and local secrets
.env
.env.*
!.env.example
!.env.sample
.envrc
.direnv/

# Private keys and credentials
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
authorized_keys
known_hosts

# Local runtime artifacts
*.log
tmp/
.cache/

# Generated visual test reports
scripts/testing/visual_integrity/reports/*
!scripts/testing/visual_integrity/reports/.gitignore
